[Unit]
Description=MechArm Control Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi
Environment=INFERENCE_URL=http://172.20.10.3:5001
ExecStart=/usr/bin/python3 -m server.app
TimeoutStopSec=10
ExecStopPost=-/usr/bin/fuser -k /dev/video0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
